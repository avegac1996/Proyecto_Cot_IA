# ─── Base de Datos ───
POSTGRES_DB=cotia
POSTGRES_USER=cotia_user
POSTGRES_PASSWORD=cotia_pass
DATABASE_URL=postgresql+asyncpg://cotia_user:cotia_pass@postgres:5432/cotia

# ─── Configuración ───
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# ─── Autenticación JWT ───
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BCRYPT_COST_FACTOR=12

# Gemini. Si se guarda una clave desde el panel, GEMINI_KEY_ENCRYPTION_KEY
# es obligatoria y debe ser una Fernet key generada y custodiada fuera de la BD.
GEMINI_API_KEY=
GEMINI_KEY_ENCRYPTION_KEY=
